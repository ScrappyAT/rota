{
  "name": "rota",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @rota/api",
    "dev:mobile": "npm run dev -w @rota/mobile",
    "build:shared": "npm run build -w @rota/shared",
    "build:api": "npm run build:shared && npm run build -w @rota/api",
    "build:mobile": "npm run build:shared",
    "build": "npm run build:shared && npm run build -w @rota/api",
    "eas-build-post-install": "npm run build:shared",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:start": "docker compose -f infrastructure/docker-compose.yml up -d",
    "db:stop": "docker compose -f infrastructure/docker-compose.yml down",
    "db:migrate": "npm run db:migrate -w @rota/api",
    "db:seed:activity": "npm run db:seed:activity -w @rota/api",
    "db:seed:dataset": "npm run db:seed:dataset -w @rota/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "typescript-eslint": "^8.71.1"
  }
}
