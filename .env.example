# API Config
PORT=3000
NODE_ENV=development

# Database Config
DATABASE_URL="postgres://postgres:postgres@localhost:5440/rota"

# Redis Config
REDIS_URL="redis://localhost:6380"

# Auth
# Required and non-default when NODE_ENV=production
JWT_SECRET="supersecretjwtkey"
JWT_REFRESH_SECRET="supersecretjwtrefreshkey"

# CORS: comma-separated origin allow-list. '*' is dev-only; refused when
# NODE_ENV=production.
CORS_ORIGIN="*"

# Billing / Flutterwave
# Get keys at https://dashboard.flutterwave.com (use test keys for sandbox).
# FLW_SECRET_KEY and FLW_SECRET_HASH are required when NODE_ENV=production.
FLW_SECRET_KEY=""
FLW_PUBLIC_KEY=""
FLW_SECRET_HASH=""
FLW_ENV=sandbox
FLW_BASE_URL="https://api.flutterwave.com"
BILLING_CURRENCY=NGN
BILLING_PERIOD_DAYS=30
SUBSCRIPTION_GRACE_DAYS=14

# Push notifications
# Expo push service endpoint (override only in tests/self-hosted setups).
EXPO_PUSH_URL="https://exp.host/--/api/v2/push/send"

# Mobile Config
# Set to the deployed HTTPS API host when building via EAS.
EXPO_PUBLIC_API_URL="http://localhost:3000"