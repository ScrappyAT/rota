# API Config
PORT=3000
NODE_ENV=development

# Database Config
DATABASE_URL="postgres://postgres:postgres@localhost:5440/rota"

# Redis Config
REDIS_URL="redis://localhost:6380"

# Auth
# Required and non-default when NODE_ENV=production
JWT_SECRET="supersecretjwtkey"
JWT_REFRESH_SECRET="supersecretjwtrefreshkey"

# CORS: comma-separated origin allow-list. Include http://localhost:8081 for
# Expo web development. '*' is dev-only; refused when NODE_ENV=production.
CORS_ORIGIN="http://localhost:8081"

# Request limiter budgets (max requests / 15 minutes / IP). Raise ONLY on a
# dedicated load-test instance; production keeps the conservative defaults.
# AUTH_RATE_LIMIT_MAX=100
# TEAMS_RATE_LIMIT_MAX=300
# INVITATIONS_RATE_LIMIT_MAX=300

# Billing / Flutterwave
# Get keys at https://dashboard.flutterwave.com (use test keys for sandbox).
# FLW_SECRET_KEY and FLW_SECRET_HASH are required when NODE_ENV=production.
FLW_SECRET_KEY=""
FLW_PUBLIC_KEY=""
FLW_SECRET_HASH=""
FLW_ENV=sandbox
FLW_BASE_URL="https://api.flutterwave.com"
# Legacy/default currency only. New assignment catalog rows use USD explicitly.
# Do not change this setting to reinterpret historical NGN records.
BILLING_CURRENCY=NGN
BILLING_PERIOD_DAYS=30
SUBSCRIPTION_GRACE_DAYS=14

# Push notifications
# Expo push service endpoint (override only in tests/self-hosted setups).
EXPO_PUSH_URL="https://exp.host/--/api/v2/push/send"

# Mobile Config
# Set to the deployed HTTPS API host when building via EAS.
EXPO_PUBLIC_API_URL="http://localhost:3000"
# R1 tests: npm run test:r1 pins disposable database/Redis ports
# 5540/6480/5541/5542 and dummy local payment/push URLs in scripts/test-r1.ps1.
# These are test-only overrides; normal development ports remain 5440/6380.

# R2 workers (run a separate npm run worker process after build/migration).
JOB_QUEUE_NAME=rota-jobs
JOB_ATTEMPTS=5
JOB_BACKOFF_MS=1000
JOB_POLL_MS=1000
JOB_CONCURRENCY=2
EXPO_PUSH_RECEIPTS_URL="https://exp.host/--/api/v2/push/getReceipts"
# R2 tests use scripts/test-r2.ps1 and docker-compose.r2-tests.yml only.
# Both push endpoints and Flutterwave are pinned to local dummy endpoints there.

# R3: independent read endpoint for allowlisted nonfinancial reads. Leave unset
# for primary-only operation. Never point this at either team-hash shard.
# READ_DATABASE_URL=postgres://READ_USER:READ_PASSWORD@READ_HOST:5432/rota
DB_POOL_MAX=10
# Authentication emails use a Resend-compatible API in the separate R2 worker.
# Generate AUTH_MAIL_KEY with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_MAIL_KEY=<64 hex characters; secret, server only; retain while jobs exist>
# MAIL_API_KEY=<server-only provider key>
# MAIL_FROM=Rota <verified-sender@your-domain.example>
MAIL_API_URL=https://api.resend.com/emails
AUTH_LINK_BASE=rota://action
# Production requires key, sender and HTTPS mail provider. No EXPO_PUBLIC secrets.
# R3 tests: docker-compose.r3-tests.yml and npm run test:r3 only, dummy keys,
# localhost providers, 5540/6480 main services, 5541/5542 shards, 5543 read drill.

# Phase 3 optional error tracking. Empty/invalid DSNs disable delivery safely.
# Node API + worker (private service configuration; never set real values in tests).
SENTRY_DSN=
# Public ingestion DSN only; bundled into mobile JS. Never put SENTRY_AUTH_TOKEN here.
EXPO_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN is NOT needed at runtime. No source-map upload is enabled.

# Integrated runtime: Docker PORT=8080; development stays PORT=3000.
# Worker runs separately; migrations require an explicitly approved release job.
