{
  "name": "@rota/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "ts-node src/migrate.ts",
    "db:seed:activity": "ts-node scripts/seed-activity.ts",
    "db:seed:dataset": "ts-node scripts/seed-dataset.ts",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:sharding": "jest __tests__/sharding.test.ts",
    "demo:sharding": "ts-node scripts/demo-sharding.ts",
    "worker": "node dist/worker.js",
    "worker:dev": "ts-node src/worker.ts",
    "jobs:status": "node dist/jobs-cli.js",
    "jobs:retry": "node dist/jobs-cli.js retry"
  },
  "dependencies": {
    "@rota/shared": "*",
    "@sentry/node": "11.11.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.5",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.20",
    "@types/jest": "^29.5.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.10.8",
    "@types/supertest": "^2.0.15",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  }
}
